{
  "name": "Dim Sum Sunset",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#151312",
    "editor.foreground": "#d1c6ba",
    "editorCursor.foreground": "#efe1d1",
    "editor.selectionBackground": "#352f29",
    "editor.lineHighlightBackground": "#1f1c1a",
    "editorLineNumber.foreground": "#61564d",
    "editorLineNumber.activeForeground": "#efe1d1",
    "editorIndentGuide.background1": "#352f29",
    "editorIndentGuide.activeBackground1": "#61564d",
    "sideBar.background": "#151312",
    "sideBar.foreground": "#d1c6ba",
    "sideBar.border": "#352f29",
    "activityBar.background": "#151312",
    "activityBar.foreground": "#ded2c4",
    "activityBar.inactiveForeground": "#8d7d6f",
    "statusBar.background": "#292520",
    "statusBar.foreground": "#ded2c4",
    "panel.background": "#1f1c1a",
    "panel.border": "#352f29",
    "tab.activeBackground": "#151312",
    "tab.activeForeground": "#efe1d1",
    "tab.inactiveBackground": "#1f1c1a",
    "tab.inactiveForeground": "#8d7d6f",
    "terminal.background": "#151312",
    "terminal.foreground": "#d1c6ba",
    "terminal.ansiBlack": "#151312",
    "terminal.ansiRed": "#b5655d",
    "terminal.ansiGreen": "#8a9161",
    "terminal.ansiYellow": "#bd9858",
    "terminal.ansiBlue": "#7890aa",
    "terminal.ansiMagenta": "#aa7488",
    "terminal.ansiCyan": "#6f9891",
    "terminal.ansiWhite": "#d1c6ba",
    "terminal.ansiBrightBlack": "#61564d",
    "terminal.ansiBrightRed": "#cf786d",
    "terminal.ansiBrightGreen": "#9da36f",
    "terminal.ansiBrightYellow": "#d0aa68",
    "terminal.ansiBrightBlue": "#8aa4bf",
    "terminal.ansiBrightMagenta": "#ad92b8",
    "terminal.ansiBrightCyan": "#82aca5",
    "terminal.ansiBrightWhite": "#efe1d1",
    "gitDecoration.addedResourceForeground": "#8a9161",
    "gitDecoration.modifiedResourceForeground": "#bd9858",
    "gitDecoration.deletedResourceForeground": "#b5655d",
    "errorForeground": "#b5655d",
    "input.background": "#1f1c1a",
    "input.foreground": "#d1c6ba",
    "input.border": "#352f29",
    "dropdown.background": "#1f1c1a",
    "dropdown.foreground": "#d1c6ba",
    "dropdown.border": "#352f29"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8d7d6f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#987fa2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#c27a48"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8a9161"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#bd9858"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6f9891"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7890aa"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8d7d6f"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ded2c4"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c27a48"
      }
    },
    {
      "scope": [
        "invalid",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b5655d"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8a9161"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#bd9858"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#aa7488",
    "class": "#6f9891",
    "enum": "#6f9891",
    "interface": "#6f9891",
    "struct": "#6f9891",
    "typeParameter": "#6f9891",
    "parameter": "#ded2c4",
    "variable": "#d1c6ba",
    "property": "#7890aa",
    "enumMember": "#bd9858",
    "function": "#c27a48",
    "method": "#c27a48",
    "macro": "#aa7488",
    "keyword": "#987fa2",
    "string": "#8a9161",
    "number": "#bd9858",
    "comment": "#8d7d6f"
  }
}
